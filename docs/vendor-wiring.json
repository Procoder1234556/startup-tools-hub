      "vendorRoot": "_vendor/pdf-everything/backend/src",
      "destRoot": "apps/api/src",
      "label": "pdf-everything backend → apps/api"
    },
    {
      "vendorRoot": "_vendor/pdf-everything/types/src",
      "destRoot": "packages/types/src",
      "label": "pdf-everything types → packages/types"
    }
  ],
  "runwayLib": {
    "vendorGlob": "_vendor/startup-runway-calculator/src/lib/*.ts",
    "destDir": "apps/web/lib/finance/runway",
    "extraDestFiles": ["types.ts"],
    "vendorTypes": "_vendor/startup-runway-calculator/src/types/index.ts"
  },
  "runwayUi": {
